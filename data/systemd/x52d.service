[Unit]
Description=X52 Pro HOTAS driver daemon
Documentation=https://github.com/x52pro-linux/x52pro-linux
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/x52d
Restart=on-failure
RestartSec=2
# Access to the grabbed evdev node and to uinput.
SupplementaryGroups=input

[Install]
WantedBy=graphical-session.target
