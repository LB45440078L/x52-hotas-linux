[Unit]
Description=X52 Pro HOTAS driver daemon
Documentation=https://github.com/x52pro-linux/x52pro-linux
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/x52d
Restart=on-failure
RestartSec=2
# Access comes from the udev ACL (70-x52pro.rules), so no extra groups are
# needed here; adding a group the user is not in makes systemd refuse to start.

[Install]
WantedBy=graphical-session.target
